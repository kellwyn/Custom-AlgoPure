# MT5 credentials — use keyring instead (see CREDENTIALS.md)
# Store via:  python -c "import keyring; keyring.set_password('mt5','algopure_login','YOUR_ACCOUNT')"
# These env vars are only a fallback if keyring is not set up
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=                  # path to terminal64.exe if running multiple MT5 instances

# Keyring profile name (default: algopure)
KEYRING_PROFILE=algopure

# Instrument
SYMBOL=XAUUSD              # adjust to broker symbol: XAUUSD, XAUUSDp, GOLD.f

# ── Broker profiles (used with --profile CLI arg) ──────────────────────────

# MetaQuotes Demo
PROFILE_METAQUOTES_SYMBOL=XAUUSD
PROFILE_METAQUOTES_MT5_PATH=
PROFILE_METAQUOTES_KEYRING_PROFILE=metaquotes

# BlackBull Demo — spot gold
PROFILE_BLACKBULL_SPOT_SYMBOL=XAUUSDp
PROFILE_BLACKBULL_SPOT_MT5_PATH=
PROFILE_BLACKBULL_SPOT_KEYRING_PROFILE=blackbull

# BlackBull Demo — futures gold
PROFILE_BLACKBULL_FUTURES_SYMBOL=GOLD.f
PROFILE_BLACKBULL_FUTURES_MT5_PATH=
PROFILE_BLACKBULL_FUTURES_KEYRING_PROFILE=blackbull
